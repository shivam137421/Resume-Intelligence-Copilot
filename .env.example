# ==============================================================================
# RESUMESYNC (RESUME INTELLIGENCE COPILOT) — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your private credentials.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Google Gemini API Key (Optional - for live conversational AI, JD parsing, and OCR)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Required for Auth, Cloud PostgreSQL DB, RLS, Storage)
# Get from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google OAuth Client Credentials (Optional - for Google Sign In)
# Get from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
